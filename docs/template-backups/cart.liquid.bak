<!-- Cart Page Header -->
<div class="cart-page-header">
  <h1>Your Business Toolkit</h1>
  <p>Every item in your cart is a strategic choice to invest in your operations and leadership capabilities.</p>
</div>

<!-- Cart Content -->
<div class="cart-container">
  {% if cart.item_count > 0 %}
    <div class="cart-wrapper">
      <!-- Cart Items -->
      <div class="cart-items-section">
        <!-- Business Investment Message -->
        <div class="cart-empowerment">
          <h3>You're Building Your Business</h3>
          <p>
            By choosing these tools, you're making a <em>strategic investment in your operations and leadership</em>.
            Your purchases fuel your journey to becoming an effective CEO who runs a systematized business.
          </p>
        </div>

        <!-- Cart Items Table -->
        <table class="cart-table">
          <thead>
            <tr class="cart-header-row">
              <th class="cart-header-cell">Product</th>
              <th class="cart-header-cell text-right">Price</th>
              <th class="cart-header-cell text-center">Qty</th>
              <th class="cart-header-cell text-right">Total</th>
              <th class="cart-header-cell"></th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr class="cart-item-row" data-cart-item-id="{{ item.id }}">
                <td class="cart-item-cell" data-label="Product">
                  <div class="cart-item-product">
                    <div class="cart-item-image">
                      {% if item.image %}<img src="{{ item.image | img_url: '150x150' }}" alt="{{ item.title }}">{% endif %}
                    </div>
                    <div class="cart-item-info">
                      <div class="cart-item-title">{{ item.title }}</div>
                      {% if item.variant.title != 'Default Title' %}<div class="cart-item-variant">{{ item.variant.title }}</div>{% endif %}
                      {% if item.sku %}<div class="cart-item-sku">SKU: {{ item.sku }}</div>{% endif %}
                      <div class="cart-item-price">{{ item.price | money }} each</div>
                    </div>
                  </div>
                </td>
                <td class="cart-item-cell text-right" data-label="Price">{{ item.price | money }}</td>
                <td class="cart-item-cell cart-item-qty" data-label="Qty">
                  <form action="/cart/change" method="post" class="qty-form">
                    <div class="qty-box">
                      <button type="button" class="qty-decrease" onclick="decreaseQty(this)">−</button>
                      <input type="number" name="quantity" value="{{ item.quantity }}" min="0" data-item-id="{{ item.id }}" onchange="updateQuantity(this)">
                      <button type="button" class="qty-increase" onclick="increaseQty(this)">+</button>
                    </div>
                  </form>
                </td>
                <td class="cart-item-cell cart-item-total text-right" data-label="Total">{{ item.final_line_price | money }}</td>
                <td class="cart-item-cell cart-item-remove" data-label="">
                  <form action="/cart/change" method="post">
                    <input type="hidden" name="id" value="{{ item.id }}">
                    <input type="hidden" name="quantity" value="0">
                    <button type="submit" class="btn-remove" title="Remove item">✕</button>
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="cart-summary">
        <h3 class="summary-title">Order Summary</h3>
        <div class="summary-rows">
          <div class="summary-row"><span>Subtotal</span><span>{{ cart.subtotal_price | money }}</span></div>
          <div class="summary-row total"><span>Total</span><span class="total-price">{{ cart.total_price | money }}</span></div>
        </div>
        <div class="cart-actions">
          <form action="/checkout" method="post"><button type="submit" class="btn-checkout">Proceed to Checkout</button></form>
          <a href="/collections/all" class="btn-continue">Continue Shopping</a>
        </div>
      </div>
    </div>
  {% else %}
    <div class="empty-cart">
      <div class="empty-cart-icon">📋</div>
      <h2>Build Your Toolkit</h2>
      <p>Your business toolkit is ready to be built. Explore our tools and start systematizing your operations to become the CEO your business needs.</p>
      <a href="/collections/all" class="btn-checkout">Explore Tools</a>
    </div>
  {% endif %}
</div>
