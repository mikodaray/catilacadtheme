<div class="password-page">
  <div class="password-logo">Cat <span>Ilacad</span></div>

  <div class="password-box">
    <div class="password-badge">✦ Coming Soon</div>
    <h1 class="password-title">Something<br>beautiful is<br>being built.</h1>
    <p class="password-sub">The CEO Systems Method™ store is almost ready. Enter the password below to get early access.</p>

    {% form 'storefront_password' %}
      {% if form.errors %}
        <div class="password-error">{{ form.errors | default_errors }}</div>
      {% endif %}
      <div class="password-form">
        <input
          type="password"
          name="password"
          id="password"
          class="password-input"
          placeholder="Enter password"
          autofocus
          autocomplete="current-password"
        >
        <button type="submit" class="btn-full">Enter →</button>
      </div>
    {% endform %}
  </div>

  <div class="password-footer">
    <p>Are you the store owner? <a href="/admin">Log in here</a>.</p>
  </div>
</div>
