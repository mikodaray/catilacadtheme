<!-- Cart Page Header -->
<div class="cart-page-header">
  <h1>Your Business Toolkit</h1>
  <p>Every item in your cart is a strategic choice to invest in your operations and leadership capabilities.</p>
</div>

<!-- Cart Content -->
<div class="cart-container">
  {% if cart.item_count > 0 %}
    <div class="cart-wrapper">
      <!-- Cart Items -->
      <div class="cart-items-section">
        <!-- Business Investment Message -->
        <div class="cart-empowerment">
          <h3>You're Building Your Business</h3>
          <p>
            By choosing these tools, you're making a <em>strategic investment in your operations and leadership</em>. 
            Your purchases fuel your journey to becoming an effective CEO who runs a systematized business.
          </p>
        </div>

        <!-- Cart Items Table -->
        <table class="cart-table">
          <thead>
            <tr class="cart-header-row">
              <th class="cart-header-cell">Product</th>
              <th class="cart-header-cell text-right">Price</th>
              <th class="cart-header-cell text-center">Qty</th>
              <th class="cart-header-cell text-right">Total</th>
              <th class="cart-header-cell"></th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr class="cart-item-row" data-cart-item-id="{{ item.id }}">
                <!-- Product Info -->
                <td class="cart-item-cell" data-label="Product">
                  <div class="cart-item-product">
                    <div class="cart-item-image">
                      {% if item.image %}
                        <img src="{{ item.image | img_url: '150x150' }}" alt="{{ item.title }}">
                      {% endif %}
                    </div>
                    <div class="cart-item-info">
                      <div class="cart-item-title">{{ item.title }}</div>
                      {% if item.variant.title != 'Default Title' %}
                        <div class="cart-item-variant">{{ item.variant.title }}</div>
                      {% endif %}
                      {% if item.sku %}
                        <div class="cart-item-sku">SKU: {{ item.sku }}</div>
                      {% endif %}
                      <div class="cart-item-price">{{ item.price | money }} each</div>
                    </div>
                  </div>
                </td>

                <!-- Price -->
                <td class="cart-item-cell text-right" data-label="Price">
                  {{ item.price | money }}
                </td>

                <!-- Quantity -->
                <td class="cart-item-cell cart-item-qty" data-label="Qty">
                  <form action="/cart/change" method="post" class="qty-form">
                    <div class="qty-box">
                      <button type="button" class="qty-decrease" onclick="decreaseQty(this)">−</button>
                      <input 
                        type="number" 
                        name="quantity" 
                        value="{{ item.quantity }}" 
                        min="0"
                        data-item-id="{{ item.id }}"
                        onchange="updateQuantity(this)"
                      >
                      <button type="button" class="qty-increase" onclick="increaseQty(this)">+</button>
                    </div>
                  </form>
                </td>

                <!-- Total -->
                <td class="cart-item-cell cart-item-total text-right" data-label="Total">
                  {{ item.final_line_price | money }}
                </td>

                <!-- Remove -->
                <td class="cart-item-cell cart-item-remove" data-label="">
                  <form action="/cart/change" method="post">
                    <input type="hidden" name="id" value="{{ item.id }}">
                    <input type="hidden" name="quantity" value="0">
                    <button type="submit" class="btn-remove" title="Remove item">✕</button>
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- Cart Summary Sidebar -->
      <div class="cart-summary">
        <h3 class="summary-title">Order Summary</h3>

        <!-- Summary Totals -->
        <div class="summary-rows">
          <div class="summary-row">
            <span>Subtotal</span>
            <span>{{ cart.subtotal_price | money }}</span>
          </div>

          {% if cart.cart_level_discount_applications != empty %}
            {% for discount in cart.cart_level_discount_applications %}
              <div class="summary-row" style="color: var(--sage); font-weight: 600;">
                <span>{{ discount.title }}</span>
                <span>-{{ discount.total_allocated_price | money }}</span>
              </div>
            {% endfor %}
          {% endif %}

          {% if cart.shipping_price != empty %}
            <div class="summary-row">
              <span>Estimated Shipping</span>
              <span>{{ cart.shipping_price | money }}</span>
            </div>
          {% endif %}

          {% if cart.tax_price != empty %}
            <div class="summary-row">
              <span>Estimated Tax</span>
              <span>{{ cart.tax_price | money }}</span>
            </div>
          {% endif %}

          <div class="summary-row total">
            <span>Total</span>
            <span class="total-price">{{ cart.total_price | money }}</span>
          </div>
        </div>

        <!-- Promo Code Section -->
        <div class="promo-section">
          <label class="promo-label">Have a Promo Code?</label>
          <form action="/cart/update" method="post" class="promo-form">
            <div style="display: flex; gap: 0.75rem;">
              <input 
                type="text" 
                name="discount_code" 
                class="promo-input" 
                placeholder="Enter code"
                autocomplete="off"
              >
              <button type="submit" class="promo-btn">Apply</button>
            </div>
          </form>
        </div>

        <!-- Business Investment Message -->
        <div class="summary-message">
          <strong>Free shipping</strong> on orders over $100. 
          Every purchase is an investment in your business systems and operational excellence.
        </div>

        <!-- Action Buttons -->
        <div class="cart-actions">
          <form action="/checkout" method="post">
            <button type="submit" class="btn-checkout">Proceed to Checkout</button>
          </form>
          <a href="/collections/all" class="btn-continue">Continue Shopping</a>
        </div>
      </div>
    </div>

  {% else %}
    <!-- Empty Cart State -->
    <div class="empty-cart">
      <div class="empty-cart-icon">📋</div>
      <h2>Build Your Toolkit</h2>
      <p>
        Your business toolkit is ready to be built. Explore our tools and start systematizing your operations 
        to become the CEO your business needs.
      </p>
      <a href="/collections/all" class="btn-checkout" style="display: inline-block; padding: 1rem 2.5rem; text-decoration: none; margin-top: 2rem;">
        Explore Tools
      </a>
    </div>
  {% endif %}
</div>

<script>
  function decreaseQty(button) {
    const input = button.nextElementSibling;
    const currentQty = parseInt(input.value);
    if (currentQty > 0) {
      input.value = currentQty - 1;
      updateQuantity(input);
    }
  }

  function increaseQty(button) {
    const input = button.previousElementSibling;
    const currentQty = parseInt(input.value);
    input.value = currentQty + 1;
    updateQuantity(input);
  }

  function updateQuantity(input) {
    const form = input.closest('.qty-form');
    const quantity = parseInt(input.value);
    const itemId = input.getAttribute('data-item-id');

    // Create a form to submit the quantity update
    const updateForm = document.createElement('form');
    updateForm.method = 'POST';
    updateForm.action = '/cart/change';

    const idInput = document.createElement('input');
    idInput.type = 'hidden';
    idInput.name = 'id';
    idInput.value = itemId;

    const qtyInput = document.createElement('input');
    qtyInput.type = 'hidden';
    qtyInput.name = 'quantity';
    qtyInput.value = quantity;

    updateForm.appendChild(idInput);
    updateForm.appendChild(qtyInput);
    document.body.appendChild(updateForm);
    updateForm.submit();
  }

  document.addEventListener('DOMContentLoaded', function() {
    console.log('Cart page loaded');
  });
</script>

<style>
  .text-right { text-align: right; }
  .text-center { text-align: center; }
</style>
