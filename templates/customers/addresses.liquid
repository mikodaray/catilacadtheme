<section class="customer page-width" style="display:block;align-items:initial;">
  <header style="text-align:center;margin-bottom:2.5rem;">
    <p class="eyebrow">{{ 'customers.account.title' | t }}</p>
    <h1 style="font-family:var(--font-heading);font-size:var(--font-size-3xl);margin-block:0.4rem 0.5rem;">{{ 'customers.addresses.title' | t }}</h1>
    <p><a href="{{ routes.account_url }}" class="customer__link">← {{ 'customers.account.title' | t }}</a></p>
  </header>

  <div style="display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));">
    {%- for address in customer.addresses -%}
      <div class="customer__card" style="position:relative;">
        {%- if address == customer.default_address -%}
          <div style="position:absolute;top:1rem;right:1rem;font-size:var(--font-size-xs);background:var(--color-accent-soft);color:var(--color-accent-deep);padding:0.25rem 0.65rem;border-radius:var(--radius-pill);font-weight:600;">
            ★ {{ 'customers.addresses.default' | t }}
          </div>
        {%- endif -%}

        <div style="font-weight:600;margin-bottom:0.5rem;">{{ address.name }}</div>
        <address style="font-style:normal;line-height:1.6;color:var(--color-muted);">
          {%- if address.company != blank -%}{{ address.company }}<br>{%- endif -%}
          {{ address.street }}<br>
          {{ address.city }}, {{ address.province_code }} {{ address.zip }}<br>
          {{ address.country }}
        </address>

        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:1.25rem;">
          <button type="button" class="button button--tertiary" data-address-edit-toggle="{{ address.id }}">{{ 'customers.addresses.edit_address' | t }}</button>
          {%- form 'customer_address', address -%}
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="button button--tertiary" style="color:var(--color-error);" onclick="return confirm('{{ 'customers.addresses.delete' | t }}?');">{{ 'customers.addresses.delete' | t }}</button>
          {%- endform -%}
          {%- unless address == customer.default_address -%}
            {%- form 'customer_address', address -%}
              <input type="hidden" name="_method" value="put">
              <input type="hidden" name="address[default]" value="true">
              <button type="submit" class="button button--tertiary">{{ 'customers.addresses.set_default' | t }}</button>
            {%- endform -%}
          {%- endunless -%}
        </div>

        <div hidden data-address-edit="{{ address.id }}" style="margin-top:1rem;border-top:1px solid var(--color-border-soft);padding-top:1rem;">
          {%- form 'customer_address', address -%}
            <input type="hidden" name="_method" value="put">
            <div class="field">
              <label>{{ 'customers.register.first_name' | t }}</label>
              <input type="text" name="address[first_name]" value="{{ address.first_name }}">
            </div>
            <div class="field">
              <label>{{ 'customers.register.last_name' | t }}</label>
              <input type="text" name="address[last_name]" value="{{ address.last_name }}">
            </div>
            <div class="field">
              <label>{{ 'customers.addresses.address1' | t | default: 'Street' }}</label>
              <input type="text" name="address[address1]" value="{{ address.address1 }}">
            </div>
            <div class="field">
              <label>{{ 'customers.addresses.city' | t | default: 'City' }}</label>
              <input type="text" name="address[city]" value="{{ address.city }}">
            </div>
            <div class="field">
              <label>{{ 'customers.addresses.zip' | t | default: 'ZIP / Postcode' }}</label>
              <input type="text" name="address[zip]" value="{{ address.zip }}">
            </div>
            <div class="field">
              <label>{{ 'customers.addresses.country' | t | default: 'Country' }}</label>
              <select name="address[country]" id="AddressCountry_{{ address.id }}" data-address-country>{{ country_option_tags }}</select>
            </div>
            <button type="submit" class="button button--primary">{{ 'customers.addresses.save' | t | default: 'Save changes' }}</button>
          {%- endform -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div style="margin-top:2rem;text-align:center;">
    <button type="button" class="button button--secondary" data-address-new-toggle>{{ 'customers.addresses.add_new' | t }}</button>
  </div>

  <div hidden id="new-address-form" style="margin-top:1.5rem;max-width:560px;margin-inline:auto;">
    <div class="customer__card">
      <h2 class="customer__title" style="font-size:var(--font-size-xl);">{{ 'customers.addresses.add_new' | t }}</h2>
      {%- form 'customer_address', customer.new_address -%}
        <div class="field">
          <label>{{ 'customers.register.first_name' | t }}</label>
          <input type="text" name="address[first_name]" value="{{ form.first_name }}">
        </div>
        <div class="field">
          <label>{{ 'customers.register.last_name' | t }}</label>
          <input type="text" name="address[last_name]" value="{{ form.last_name }}">
        </div>
        <div class="field">
          <label>{{ 'customers.addresses.address1' | t | default: 'Street' }}</label>
          <input type="text" name="address[address1]" value="{{ form.address1 }}" required>
        </div>
        <div class="field">
          <label>{{ 'customers.addresses.city' | t | default: 'City' }}</label>
          <input type="text" name="address[city]" value="{{ form.city }}" required>
        </div>
        <div class="field">
          <label>{{ 'customers.addresses.zip' | t | default: 'ZIP / Postcode' }}</label>
          <input type="text" name="address[zip]" value="{{ form.zip }}" required>
        </div>
        <div class="field">
          <label>{{ 'customers.addresses.country' | t | default: 'Country' }}</label>
          <select name="address[country]" id="AddressCountryNew" data-address-country>{{ country_option_tags }}</select>
        </div>
        <div class="field" style="display:flex;gap:0.5rem;align-items:center;">
          <input type="checkbox" name="address[default]" id="address_default_new" value="true" style="width:auto;">
          <label for="address_default_new" style="margin:0;font-weight:500;">{{ 'customers.addresses.set_default' | t }}</label>
        </div>
        <div class="actions">
          <button type="submit" class="button button--primary">{{ 'customers.addresses.save' | t | default: 'Save address' }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

<script>
  document.addEventListener('click', (e) => {
    const editBtn = e.target.closest('[data-address-edit-toggle]');
    if (editBtn) {
      const id = editBtn.dataset.addressEditToggle;
      const panel = document.querySelector(`[data-address-edit="${id}"]`);
      if (panel) panel.hidden = !panel.hidden;
    }
    if (e.target.matches('[data-address-new-toggle]')) {
      const f = document.getElementById('new-address-form');
      if (f) f.hidden = !f.hidden;
    }
  });
</script>
