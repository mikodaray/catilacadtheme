<div class="customer-hero">
  <h1>Your Addresses</h1>
  <p>Manage shipping and billing addresses.</p>
</div>

<div class="addresses-container">
  <div class="addresses-top">
    <h2 class="addresses-heading">Saved Addresses</h2>
    <a href="/account" class="btn-sm">← Back to Account</a>
  </div>

  <div class="addresses-grid">
    {% for address in customer.addresses %}
      <div class="address-card {% if address == customer.default_address %}is-default{% endif %}">
        {% if address == customer.default_address %}
          <div class="address-default-badge">✦ Default Address</div>
        {% endif %}
        <div class="address-name">{{ address.name }}</div>
        <address class="address-text" style="font-style:normal;">
          {% if address.company %}{{ address.company }}<br>{% endif %}
          {{ address.street }}<br>
          {{ address.city }}, {{ address.province_code }} {{ address.zip }}<br>
          {{ address.country }}
        </address>
        <div class="address-actions">
          <button
            class="btn-sm"
            onclick="toggleEdit('edit-{{ address.id }}')"
          >Edit</button>
          {% form 'customer_address', address %}
            <input type="hidden" name="_method" value="delete">
            <button
              type="submit"
              class="btn-sm btn-sm-danger"
              onclick="return confirm('Remove this address?')"
            >Remove</button>
          {% endform %}
          {% unless address == customer.default_address %}
            {% form 'customer_address', customer.default_address %}
              <input type="hidden" name="_method" value="put">
              <input type="hidden" name="address[default]" value="true">
              <input type="hidden" name="address[id]" value="{{ address.id }}">
              <button type="submit" class="btn-sm">Set Default</button>
            {% endform %}
          {% endunless %}
        </div>

        <!-- Inline edit form -->
        <div class="address-form-wrap" id="edit-{{ address.id }}">
          <div class="address-form-title">Edit Address</div>
          {% form 'customer_address', address %}
            <input type="hidden" name="_method" value="put">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">First Name</label>
                <input type="text" name="address[first_name]" class="form-input" value="{{ address.first_name }}">
              </div>
              <div class="form-group">
                <label class="form-label">Last Name</label>
                <input type="text" name="address[last_name]" class="form-input" value="{{ address.last_name }}">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Company (optional)</label>
              <input type="text" name="address[company]" class="form-input" value="{{ address.company }}">
            </div>
            <div class="form-group">
              <label class="form-label">Address</label>
              <input type="text" name="address[address1]" class="form-input" value="{{ address.address1 }}">
            </div>
            <div class="form-group">
              <label class="form-label">Apartment / Suite (optional)</label>
              <input type="text" name="address[address2]" class="form-input" value="{{ address.address2 }}">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">City</label>
                <input type="text" name="address[city]" class="form-input" value="{{ address.city }}">
              </div>
              <div class="form-group">
                <label class="form-label">ZIP / Postal Code</label>
                <input type="text" name="address[zip]" class="form-input" value="{{ address.zip }}">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Country</label>
              <select name="address[country]" class="form-input" id="AddressCountry_{{ address.id }}">
                {{ country_option_tags }}
              </select>
            </div>
            <div style="display:flex;gap:0.75rem;margin-top:1rem;">
              <button type="submit" class="btn-full" style="width:auto;padding:0.85rem 1.75rem;border-radius:100px;">Save</button>
              <button type="button" class="btn-outline-full" style="width:auto;padding:0.85rem 1.5rem;" onclick="toggleEdit('edit-{{ address.id }}')">Cancel</button>
            </div>
          {% endform %}
        </div>
      </div>
    {% endfor %}
  </div>

  <!-- Add New Address -->
  <div style="margin-top:3rem;">
    <button class="btn-primary" style="text-decoration:none;" onclick="toggleEdit('new-address')">+ Add New Address</button>
  </div>

  <div class="address-form-wrap" id="new-address" style="margin-top:1.5rem;">
    <div class="address-form-title">New Address</div>
    {% form 'customer_address', customer.new_address %}
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">First Name</label>
          <input type="text" name="address[first_name]" class="form-input" value="{{ form.first_name }}">
        </div>
        <div class="form-group">
          <label class="form-label">Last Name</label>
          <input type="text" name="address[last_name]" class="form-input" value="{{ form.last_name }}">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Company (optional)</label>
        <input type="text" name="address[company]" class="form-input" value="{{ form.company }}">
      </div>
      <div class="form-group">
        <label class="form-label">Address</label>
        <input type="text" name="address[address1]" class="form-input" value="{{ form.address1 }}" required>
      </div>
      <div class="form-group">
        <label class="form-label">Apartment / Suite (optional)</label>
        <input type="text" name="address[address2]" class="form-input" value="{{ form.address2 }}">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">City</label>
          <input type="text" name="address[city]" class="form-input" value="{{ form.city }}" required>
        </div>
        <div class="form-group">
          <label class="form-label">ZIP / Postal Code</label>
          <input type="text" name="address[zip]" class="form-input" value="{{ form.zip }}" required>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Country</label>
        <select name="address[country]" class="form-input" id="AddressCountryNew">
          {{ country_option_tags }}
        </select>
      </div>
      <div class="form-group" style="flex-direction:row;align-items:center;gap:0.75rem;">
        <input type="checkbox" name="address[default]" id="address_default_new" value="true" style="width:auto;">
        <label for="address_default_new" class="form-label" style="margin:0;font-weight:500;">Set as default address</label>
      </div>
      <button type="submit" class="btn-full">Save Address</button>
    {% endform %}
  </div>
</div>

<script>
  function toggleEdit(id) {
    const el = document.getElementById(id);
    el.classList.toggle('open');
  }
</script>
