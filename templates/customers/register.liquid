<div class="customer-hero">
  <h1>Create Your Account</h1>
  <p>Join the Cat Ilacad ecosystem and track your orders.</p>
</div>

<div class="customer-container">
  <div class="customer-box">
    <h2 class="customer-box-title">Get Started</h2>
    <p class="customer-box-sub">Already have an account? <a href="/account/login" class="form-link">Sign in →</a></p>

    {% form 'create_customer' %}
      {% if form.errors %}
        <div class="form-error">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="form-row">
        <div class="form-group">
          <label for="first_name" class="form-label">First Name</label>
          <input
            type="text"
            name="customer[first_name]"
            id="first_name"
            class="form-input"
            placeholder="Cat"
            autocomplete="given-name"
            value="{{ form.first_name }}"
          >
        </div>
        <div class="form-group">
          <label for="last_name" class="form-label">Last Name</label>
          <input
            type="text"
            name="customer[last_name]"
            id="last_name"
            class="form-input"
            placeholder="Ilacad"
            autocomplete="family-name"
            value="{{ form.last_name }}"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="email" class="form-label">Email</label>
        <input
          type="email"
          name="customer[email]"
          id="email"
          class="form-input"
          placeholder="you@example.com"
          autocomplete="email"
          value="{{ form.email }}"
          required
        >
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <input
          type="password"
          name="customer[password]"
          id="password"
          class="form-input"
          placeholder="Choose a strong password"
          autocomplete="new-password"
          required
          minlength="5"
        >
      </div>

      <button type="submit" class="btn-full">Create Account →</button>
    {% endform %}
  </div>
</div>
