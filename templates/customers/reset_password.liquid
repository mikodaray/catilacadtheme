<div class="customer-hero">
  <h1>Reset Password</h1>
  <p>Enter a new password for your account.</p>
</div>

<div class="customer-container">
  <div class="customer-box">
    <h2 class="customer-box-title">Set New Password</h2>
    <p class="customer-box-sub">Choose a strong password you'll remember.</p>

    {% form 'reset_customer_password' %}
      {% if form.errors %}
        <div class="form-error">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="form-group">
        <label for="password" class="form-label">New Password</label>
        <input
          type="password"
          name="customer[password]"
          id="password"
          class="form-input"
          placeholder="New password"
          autocomplete="new-password"
          required
          minlength="5"
        >
      </div>

      <div class="form-group">
        <label for="password_confirmation" class="form-label">Confirm Password</label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="password_confirmation"
          class="form-input"
          placeholder="Repeat new password"
          autocomplete="new-password"
          required
        >
      </div>

      <button type="submit" class="btn-full">Reset Password →</button>
    {% endform %}
  </div>
</div>
