<section class="customer page-width">
  <div class="customer__card">
    <h1 class="customer__title">{{ 'customers.reset_password.title' | t }}</h1>
    <p class="customer__subtitle">{{ 'customers.reset_password.set_new' | t | default: 'Choose a strong password you’ll remember.' }}</p>

    {%- form 'reset_customer_password', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="customer__error" role="alert" aria-live="assertive">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="field">
        <label for="reset-password">{{ 'customers.reset_password.new_password' | t | default: 'New password' }}</label>
        <input type="password" name="customer[password]" id="reset-password" autocomplete="new-password" minlength="5" required>
      </div>

      <div class="field">
        <label for="reset-password-confirm">{{ 'customers.reset_password.confirm_password' | t | default: 'Confirm password' }}</label>
        <input type="password" name="customer[password_confirmation]" id="reset-password-confirm" autocomplete="new-password" required>
      </div>

      <div class="actions">
        <button type="submit" class="button button--primary">{{ 'customers.reset_password.submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>
