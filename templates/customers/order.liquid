<div class="customer-hero">
  <h1>Order {{ order.name }}</h1>
  <p>Placed on {{ order.created_at | date: '%B %-d, %Y' }}</p>
</div>

<div class="order-container">
  <a href="/account" class="order-back">← Back to Account</a>

  <div class="order-header">
    <div>
      <div class="order-heading">Order {{ order.name }}</div>
      <div class="order-date">{{ order.created_at | date: '%B %-d, %Y at %-I:%M %p' }}</div>
    </div>
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
      <span class="order-badge {{ order.financial_status }}">{{ order.financial_status | capitalize }}</span>
      <span class="order-badge {{ order.fulfillment_status | default: 'unfulfilled' }}">
        {{ order.fulfillment_status | default: 'Unfulfilled' | capitalize }}
      </span>
    </div>
  </div>

  <div class="order-detail-grid">
    <!-- Line Items -->
    <div>
      <div class="order-card">
        <div class="order-card-title">Items Ordered</div>
        {% for line_item in order.line_items %}
          <div class="order-line">
            <div class="order-line-img">
              {% if line_item.image %}
                <img src="{{ line_item.image | img_url: '120x120' }}" alt="{{ line_item.title | escape }}">
              {% endif %}
            </div>
            <div class="order-line-info">
              <div class="order-line-title">{{ line_item.title }}</div>
              {% if line_item.variant.title != 'Default Title' %}
                <div class="order-line-meta">{{ line_item.variant.title }}</div>
              {% endif %}
              <div class="order-line-meta">Qty: {{ line_item.quantity }}</div>
            </div>
            <div class="order-line-price">{{ line_item.final_line_price | money }}</div>
          </div>
        {% endfor %}
      </div>

      <!-- Shipping address -->
      {% if order.shipping_address %}
        <div class="order-card" style="margin-top:1.5rem;">
          <div class="order-card-title">Shipping Address</div>
          <address class="order-address" style="font-style:normal;">
            {{ order.shipping_address.name }}<br>
            {% if order.shipping_address.company %}{{ order.shipping_address.company }}<br>{% endif %}
            {{ order.shipping_address.street }}<br>
            {{ order.shipping_address.city }}, {{ order.shipping_address.province_code }} {{ order.shipping_address.zip }}<br>
            {{ order.shipping_address.country }}
          </address>
        </div>
      {% endif %}
    </div>

    <!-- Order Summary -->
    <div>
      <div class="order-card">
        <div class="order-card-title">Order Summary</div>
        <div class="order-summary-row">
          <span>Subtotal</span>
          <span>{{ order.subtotal_price | money }}</span>
        </div>
        {% if order.shipping_price and order.shipping_price > 0 %}
          <div class="order-summary-row">
            <span>Shipping</span>
            <span>{{ order.shipping_price | money }}</span>
          </div>
        {% endif %}
        {% if order.tax_price and order.tax_price > 0 %}
          <div class="order-summary-row">
            <span>Tax</span>
            <span>{{ order.tax_price | money }}</span>
          </div>
        {% endif %}
        {% for discount in order.discounts %}
          <div class="order-summary-row" style="color:var(--sage);">
            <span>{{ discount.code }}</span>
            <span>-{{ discount.savings | money }}</span>
          </div>
        {% endfor %}
        <div class="order-summary-row total">
          <span>Total</span>
          <span>{{ order.total_price | money }}</span>
        </div>
      </div>
    </div>
  </div>
</div>
