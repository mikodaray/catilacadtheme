<div class="customer-hero">
  <h1>Activate Your Account</h1>
  <p>Set your password to complete your account setup.</p>
</div>

<div class="customer-container">
  <div class="customer-box">
    <h2 class="customer-box-title">Create Password</h2>
    <p class="customer-box-sub">You're almost in. Set a password to activate your Cat Ilacad account.</p>

    {% form 'activate_customer_password' %}
      {% if form.errors %}
        <div class="form-error">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <input
          type="password"
          name="customer[password]"
          id="password"
          class="form-input"
          placeholder="Choose a password"
          autocomplete="new-password"
          required
          minlength="5"
        >
      </div>

      <div class="form-group">
        <label for="password_confirmation" class="form-label">Confirm Password</label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="password_confirmation"
          class="form-input"
          placeholder="Repeat your password"
          autocomplete="new-password"
          required
        >
      </div>

      <button type="submit" class="btn-full">Activate Account →</button>
    {% endform %}

    <div class="form-footer">
      <p>Already have access? <a href="/account/login" class="form-link">Sign in instead</a></p>
    </div>
  </div>
</div>
