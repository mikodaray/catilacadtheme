<section class="customer page-width">
  <div class="customer__card">
    <h1 class="customer__title">{{ 'customers.activate_account.title' | t | default: 'Activate your account' }}</h1>
    <p class="customer__subtitle">{{ 'customers.activate_account.subtext' | t | default: 'You’re almost in. Set a password to activate your account.' }}</p>

    {%- form 'activate_customer_password', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="customer__error" role="alert" aria-live="assertive">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="field">
        <label for="activate-password">{{ 'customers.register.password' | t }}</label>
        <input type="password" name="customer[password]" id="activate-password" autocomplete="new-password" minlength="5" required>
      </div>

      <div class="field">
        <label for="activate-password-confirm">{{ 'customers.reset_password.confirm_password' | t | default: 'Confirm password' }}</label>
        <input type="password" name="customer[password_confirmation]" id="activate-password-confirm" autocomplete="new-password" required>
      </div>

      <div class="actions">
        <button type="submit" class="button button--primary">{{ 'customers.activate_account.submit' | t | default: 'Activate' }}</button>
        <button type="submit" name="decline" class="button button--tertiary" style="background:transparent;color:var(--color-muted);">
          {{ 'customers.activate_account.decline' | t | default: 'Decline invitation' }}
        </button>
      </div>
    {%- endform -%}
  </div>
</section>
