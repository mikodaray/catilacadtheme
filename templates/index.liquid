    </div>
  </div>
</div>

<script>
  function toggleFaq(el) {
    const item = el.parentElement;
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  }

  (function () {
    // Disable scroll snap entirely when the URL has a hash (e.g. /#mentorship)
    // so anchor links can scroll freely to their target section.
    if (window.location.hash) return;

    var hero = document.querySelector('.funnel-hero');
    var next = document.querySelector('.intro-section');
    if (!hero || !next) return;

    var snapping = false;
    var lastY = 0;

    window.addEventListener('scroll', function () {
      if (snapping) return;
      var y = window.scrollY;
      var heroH = hero.offsetHeight;
      var goingDown = y > lastY;
      lastY = y;

      if (goingDown && y > 20 && y < heroH) {
        snapping = true;
        next.scrollIntoView({ behavior: 'smooth' });
        setTimeout(function () { snapping = false; }, 1000);
      }

      if (!goingDown && y > 0 && y < heroH) {
        snapping = true;
        window.scrollTo({ top: 0, behavior: 'smooth' });
        setTimeout(function () { snapping = false; }, 1000);
      }
    }, { passive: true });
  })();

  (function () {
    var popup  = document.getElementById('teaser-popup');
    var banner = document.getElementById('teaser-banner');

    var params = new URLSearchParams(window.location.search);
    var promoParam = params.get('promo');
    var promoActive = promoParam === 'true';

    function openPopup() {
      banner.classList.remove('banner-visible');
      popup.classList.remove('popup-hiding');
      popup.style.display = 'flex';
      requestAnimationFrame(function () { popup.classList.add('popup-visible'); });
      var video = popup.querySelector('video');
      if (video) {
        video.play().catch(function () {
          video.muted = true;
          video.play().catch(function () {});
        });
      }
    }

    function closePopup() {
      popup.classList.remove('popup-visible');
      popup.classList.add('popup-hiding');
      setTimeout(function () {
        popup.style.display = 'none';
        banner.classList.add('banner-visible');
      }, 300);
    }

    // Always show the floating banner
    banner.classList.add('banner-visible');

    // Only auto-open the popup when ?promo=true
    if (promoActive) {
      setTimeout(openPopup, 1000);
    }

    document.getElementById('teaser-close').addEventListener('click', closePopup);
    popup.addEventListener('click', function (e) {
      if (e.target === popup) closePopup();
    });
    banner.addEventListener('click', openPopup);
  })();
</script>