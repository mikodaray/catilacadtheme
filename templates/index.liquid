<!-- TEASER POPUP -->
<div id="teaser-popup" role="dialog" aria-modal="true" aria-labelledby="teaser-heading">
  <div class="popup-card">
    <button class="popup-close" id="teaser-close" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <div class="popup-content">
      <div class="popup-badge">✦ Free Download</div>
      <h2 class="popup-heading" id="teaser-heading">Get your freebie now.</h2>
