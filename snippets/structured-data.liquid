{% comment %}
  Renders JSON-LD structured data:
    - Organization (every page)
    - Product (with brand, offers, sku, images, availability)
    - CollectionPage + BreadcrumbList (on collections)
    - BreadcrumbList (on product pages with a referring collection)
    - Article (with author, dates, images, body)

  Validate with Google's Rich Results Test before launching.

  Usage:
    {% render 'structured-data' %}
{% endcomment %}

{%- liquid
  assign org_logo = settings.logo | default: settings.share_image
-%}

{%- comment %} ----- Organization (sitewide) ----- {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }}
  {%- if org_logo -%},
  "logo": {{ org_logo | image_url: width: 500 | prepend: 'https:' | json }}
  {%- endif -%}
  {%- if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_twitter_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank -%},
  "sameAs": [
    {%- assign social_links = '' | split: '' -%}
    {%- if settings.social_instagram_link != blank -%}{%- assign social_links = social_links | push: settings.social_instagram_link -%}{%- endif -%}
    {%- if settings.social_facebook_link != blank -%}{%- assign social_links = social_links | push: settings.social_facebook_link -%}{%- endif -%}
    {%- if settings.social_twitter_link != blank -%}{%- assign social_links = social_links | push: settings.social_twitter_link -%}{%- endif -%}
    {%- if settings.social_youtube_link != blank -%}{%- assign social_links = social_links | push: settings.social_youtube_link -%}{%- endif -%}
    {%- if settings.social_tiktok_link != blank -%}{%- assign social_links = social_links | push: settings.social_tiktok_link -%}{%- endif -%}
    {%- for url in social_links -%}{{ url | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
  ]
  {%- endif -%}
}
</script>

{%- comment %} ----- Product ----- {%- endcomment -%}
{%- if request.page_type == 'product' and product -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    "description": {{ product.description | strip_html | json }},
    {%- if product.featured_image -%}
    "image": [
      {%- for img in product.images limit: 5 -%}
        {{ img | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    {%- endif -%}
    {%- if product.vendor != blank -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- endif -%}
    {%- if current_variant.sku != blank -%}
    "sku": {{ current_variant.sku | json }},
    {%- endif -%}
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ current_variant.price | divided_by: 100.0 | json }},
      "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "url": {{ shop.url | append: product.url | json }},
      "itemCondition": "https://schema.org/NewCondition"
    }
  }
  </script>

  {%- comment %} BreadcrumbList for product pages — always shows Home, plus collection if available. {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} }
      {%- if collection -%}
      , { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
      , { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
      {%- else -%}
      , { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
      {%- endif -%}
    ]
  }
  </script>
{%- endif -%}

{%- comment %} ----- Collection ----- {%- endcomment -%}
{%- if request.page_type == 'collection' and collection -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ collection.title | json }},
    "url": {{ shop.url | append: collection.url | json }},
    "description": {{ collection.description | strip_html | json }}
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
    ]
  }
  </script>
{%- endif -%}

{%- comment %} ----- Article ----- {%- endcomment -%}
{%- if request.page_type == 'article' and article -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "url": {{ shop.url | append: article.url | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "author": { "@type": "Person", "name": {{ article.author | json }} },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
      {%- if org_logo -%},
      "logo": { "@type": "ImageObject", "url": {{ org_logo | image_url: width: 500 | prepend: 'https:' | json }} }
      {%- endif -%}
    },
    {%- if article.image -%}
    "image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ article.excerpt_or_content | strip_html | truncatewords: 30 | json }},
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": { "@type": "WebPage", "@id": {{ shop.url | append: article.url | json }} }
  }
  </script>
{%- endif -%}
