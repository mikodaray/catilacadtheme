{% comment %}
  Renders a responsive <img> with Dawn-style srcset (widths
  165 / 360 / 533 / 720 / 940 / 1066 / 1500 / 2000), explicit width &
  height to prevent CLS, lazy loading by default, and a configurable
  `sizes` attribute.

  Accepts:
  - image: {Image} required - Shopify image object.
  - alt: {String} optional alt text. Falls back to image.alt.
  - sizes: {String} CSS sizes attribute (default "100vw").
  - widths: {String} comma-separated srcset widths to override the default.
  - aspect_ratio: {Number|String} optional override (defaults to image.aspect_ratio).
  - loading: {String} "lazy" | "eager" (default "lazy").
  - fetchpriority: {String} "auto" | "high" | "low" (default "auto").
  - class: {String} extra wrapper class.

  Usage:
    {% render 'responsive-image', image: section.settings.image, sizes: '(min-width: 750px) 50vw, 100vw' %}
{% endcomment %}

{%- liquid
  assign img = image
  assign img_alt = alt | default: img.alt | escape
  assign img_sizes = sizes | default: '100vw'
  assign default_widths = '165, 360, 533, 720, 940, 1066, 1500, 2000'
  assign img_widths = widths | default: default_widths
  assign img_loading = loading | default: 'lazy'
  assign img_priority = fetchpriority | default: 'auto'
  assign ratio = aspect_ratio | default: img.aspect_ratio | default: 1
  assign extra_class = class | default: ''
  assign widths_array = img_widths | replace: ' ', '' | split: ','
-%}

{%- if img != blank -%}
  <div class="responsive-image {{ extra_class }}" style="--aspect-ratio: {{ ratio }};">
    <img
      src="{{ img | image_url: width: 1000 }}"
      srcset="
        {%- for w in widths_array -%}
          {%- assign width_int = w | plus: 0 -%}
          {%- if width_int > 0 and width_int <= img.width -%}
            {{ img | image_url: width: width_int }} {{ width_int }}w{%- unless forloop.last -%},{%- endunless %}
          {%- endif -%}
        {%- endfor -%}
      "
      sizes="{{ img_sizes }}"
      width="{{ img.width }}"
      height="{{ img.height }}"
      alt="{{ img_alt }}"
      loading="{{ img_loading }}"
      fetchpriority="{{ img_priority }}"
      decoding="async"
    >
  </div>
{%- else -%}
  <div class="responsive-image responsive-image--placeholder {{ extra_class }}" style="--aspect-ratio: {{ ratio }};">
    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
  </div>
{%- endif -%}
