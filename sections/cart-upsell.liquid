{% comment %}
  Cart-page upsell — picks one product from a configured collection that the
  shopper hasn't already added to cart. Hides if all products in the collection
  are already in cart, or if no collection is configured.

  Used inside templates/cart.json. Server-side picks an eligible product on
  page load; if all products in the collection are present in cart, hides.
{% endcomment %}

{%- liquid
  assign upsell_collection = collections[section.settings.collection]
  assign chosen = blank
  if upsell_collection != blank
    assign cart_product_ids = ''
    for item in cart.items
      assign cart_product_ids = cart_product_ids | append: item.product_id | append: ','
    endfor
    for candidate in upsell_collection.products
      assign id_token = candidate.id | append: ','
      unless cart_product_ids contains id_token
        if candidate.available
          assign chosen = candidate
          break
        endif
      endunless
    endfor
  endif
-%}

{%- if chosen != blank -%}
  <section class="cart-upsell page-width">
    <div class="cart-upsell__inner">
      <div class="cart-upsell__copy">
        {%- if section.settings.heading != blank -%}
          <p class="eyebrow">{{ section.settings.heading | escape }}</p>
        {%- endif -%}
        <h2 class="cart-upsell__title">{{ chosen.title | escape }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="cart-upsell__description">{{ section.settings.description }}</p>
        {%- endif -%}
        <div class="cart-upsell__price">{{ chosen.price | money }}</div>
      </div>

      <div class="cart-upsell__media">
        <a href="{{ chosen.url }}" tabindex="-1" aria-hidden="true">
          {% render 'responsive-image',
            image: chosen.featured_image,
            sizes: '(min-width: 750px) 33vw, 50vw',
            aspect_ratio: 1
          %}
        </a>
      </div>

      <form
        is="cart-form"
        method="post"
        action="{{ routes.cart_add_url }}"
        class="cart-upsell__form"
      >
        <input type="hidden" name="id" value="{{ chosen.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="button button--primary" data-add-button>
          {{ section.settings.button_label | default: 'Add to cart' }}
        </button>
        <a href="{{ chosen.url }}" class="button button--tertiary cart-upsell__view">{{ 'products.product.view_full_details' | t }}</a>
      </form>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Cart upsell",
  "tag": "section",
  "class": "section section--cart-upsell",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Upsell collection" },
    { "type": "text", "id": "heading", "label": "Eyebrow", "default": "Complete your set" },
    { "type": "richtext", "id": "description", "label": "Description (optional)" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" }
  ],
  "presets": [{ "name": "Cart upsell" }]
}
{% endschema %}
