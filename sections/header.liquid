{% comment %}
  Header — logo, primary navigation, search trigger, cart count.
  Uses <mobile-menu> and <predictive-search> custom elements from theme.js.
{% endcomment %}

<mobile-menu>
  <header class="site-header" role="banner">
    <div class="page-width site-header__inner">
      <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: section.settings.logo_width | times: 2 }}"
            alt="{{ shop.name | escape }}"
            width="{{ section.settings.logo_width }}"
            height="{{ section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio }}"
            style="max-width: {{ section.settings.logo_width }}px;"
          >
        {%- else -%}
          <span class="site-header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <nav class="site-header__nav" aria-label="Primary" data-mobile-menu-panel hidden>
        {%- for link in linklists[section.settings.menu].links -%}
          <a href="{{ link.url }}" class="site-header__link">{{ link.title }}</a>
        {%- endfor -%}
      </nav>

      <div class="site-header__actions">
        {%- if section.settings.show_search -%}
          <predictive-search class="site-header__search">
            <form action="{{ routes.search_url }}" method="get" role="search">
              <label for="HeaderSearch" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
              <input
                id="HeaderSearch"
                type="search"
                name="q"
                placeholder="{{ 'search.placeholder' | t }}"
                autocomplete="off"
                data-search-input
              >
              <button type="submit" class="site-header__action" aria-label="{{ 'search.title' | t }}">
                {% render 'icon', icon: 'search' %}
              </button>
            </form>
            <div class="site-header__search-results" data-search-results></div>
          </predictive-search>
        {%- endif -%}

        <a href="{{ routes.cart_url }}" class="site-header__action site-header__cart" aria-label="{{ 'cart.general.title' | t }}">
          {% render 'icon', icon: 'cart' %}
          <span class="site-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
        </a>

        <button
          type="button"
          class="site-header__action site-header__menu-toggle"
          data-mobile-menu-toggle
          aria-expanded="false"
          aria-label="Toggle menu"
        >
          {% render 'icon', icon: 'menu' %}
        </button>
      </div>
    </div>
  </header>
</mobile-menu>

{% stylesheet %}
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--color-bg); border-bottom: 1px solid rgba(0,0,0,0.06); backdrop-filter: blur(8px); }
  .site-header__inner { display: flex; align-items: center; gap: 1rem; padding-block: 1rem; }
  .site-header__logo { flex: 0 0 auto; text-decoration: none; color: inherit; }
  .site-header__logo img { display: block; height: auto; }
  .site-header__logo-text { font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; }
  .site-header__nav { flex: 1; display: flex; gap: 2rem; justify-content: center; }
  .site-header__link { font-size: 0.9rem; color: var(--color-text); text-decoration: none; }
  .site-header__link:hover { color: var(--color-accent); }
  .site-header__actions { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; }
  .site-header__action { background: none; border: 0; cursor: pointer; padding: 0.5rem; color: var(--color-text); display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none; }
  .site-header__cart-count { font-size: 0.7rem; font-weight: 700; background: var(--color-accent); color: #fff; border-radius: 999px; padding: 0.05rem 0.45rem; min-width: 1.25rem; text-align: center; }
  .site-header__cart-count.is-hidden { display: none; }
  .site-header__menu-toggle { display: none; }
  .site-header__search input { padding: 0.45rem 0.75rem; border: 1px solid rgba(0,0,0,0.12); border-radius: 999px; font: inherit; }
  .site-header__search-results { position: absolute; right: 0; top: calc(100% + 0.5rem); width: min(360px, 90vw); }
  @media (max-width: 749px) {
    .site-header__nav { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; gap: 1rem; padding: 1.5rem; background: var(--color-bg); border-bottom: 1px solid rgba(0,0,0,0.06); }
    mobile-menu.is-open .site-header__nav { display: flex; }
    .site-header__menu-toggle { display: inline-flex; }
    .site-header__search { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60, "max": 240, "step": 10, "default": 120, "unit": "px"
    },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true }
  ]
}
{% endschema %}
