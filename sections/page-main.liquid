<div class="page-hero">
  <div class="hero-badge">✦ {{ page.title }}</div>
  <h1 class="page-title">{{ page.title }}</h1>
</div>

<div class="page-container">
  <div class="page-content rte">
    {{ page.content }}
  </div>
  {% content_for "blocks" %}
</div>

{% schema %}
{
  "name": "Page Content",
  "tag": "section",
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Page Content" }],
  "settings": []
}
{% endschema %}
