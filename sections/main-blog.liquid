{% comment %}
  Main blog index. Featured-first card on top, grid of remaining articles below,
  paginated. Uses brand typography + product-card-style image treatment.
{% endcomment %}

{%- liquid
  assign per_page = section.settings.per_page | default: 9
-%}

<section class="main-blog page-width">
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      <div class="main-blog__app-block" {{ block.shopify_attributes }}>{% render block %}</div>
    {%- endif -%}
  {%- endfor -%}

  <header class="main-blog__header">
    <p class="eyebrow">{{ blog.title }}</p>
    {%- if section.settings.heading != blank -%}
      <h1 class="main-blog__title">{{ section.settings.heading | escape }}</h1>
    {%- else -%}
      <h1 class="main-blog__title">{{ blog.title }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="main-blog__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </header>

  {%- paginate blog.articles by per_page -%}
    {%- if blog.articles.size > 0 -%}

      {%- comment %} Featured (first) article — large card, full-width on mobile, two-column on desktop. {% endcomment -%}
      {%- assign featured = blog.articles.first -%}
      {%- if section.settings.show_featured -%}
        <article class="main-blog__featured">
          <a class="main-blog__featured-link" href="{{ featured.url }}">
            <div class="main-blog__featured-media">
              {%- if featured.image -%}
                {% render 'responsive-image',
                  image: featured.image,
                  sizes: '(min-width: 750px) 60vw, 100vw',
                  loading: 'eager',
                  fetchpriority: 'high',
                  aspect_ratio: 1.5
                %}
              {%- endif -%}
            </div>
            <div class="main-blog__featured-body">
              <div class="main-blog__meta">
                {%- if featured.tags.size > 0 -%}
                  <span class="main-blog__tag">{{ featured.tags.first }}</span>
                {%- endif -%}
                <span class="main-blog__date">{{ featured.published_at | date: '%B %-d, %Y' }}</span>
                {%- if featured.author != blank -%}
                  <span class="main-blog__author">{{ 'blogs.article.by_author' | t: author: featured.author }}</span>
                {%- endif -%}
              </div>
              <h2 class="main-blog__featured-title">{{ featured.title | escape }}</h2>
              <p class="main-blog__excerpt">
                {{ featured.excerpt_or_content | strip_html | truncatewords: 32 }}
              </p>
              <span class="button button--tertiary main-blog__read-more">{{ 'blogs.article.read_more' | t }}</span>
            </div>
          </a>
        </article>
      {%- endif -%}

      {%- comment %} Grid of remaining articles. {% endcomment -%}
      {%- assign skip_first = section.settings.show_featured -%}
      <ul class="main-blog__grid main-blog__grid--columns-{{ section.settings.columns_desktop }}">
        {%- for article in blog.articles -%}
          {%- if skip_first and forloop.first -%}{%- continue -%}{%- endif -%}
          <li class="main-blog__grid-item">
            <article class="blog-card">
              <a class="blog-card__link" href="{{ article.url }}">
                <div class="blog-card__media">
                  {%- if article.image -%}
                    {% render 'responsive-image',
                      image: article.image,
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                      aspect_ratio: 1.5
                    %}
                  {%- endif -%}
                </div>
                <div class="blog-card__body">
                  <div class="main-blog__meta">
                    {%- if article.tags.size > 0 -%}
                      <span class="main-blog__tag">{{ article.tags.first }}</span>
                    {%- endif -%}
                    <span class="main-blog__date">{{ article.published_at | date: '%b %-d, %Y' }}</span>
                  </div>
                  <h3 class="blog-card__title">{{ article.title | escape }}</h3>
                  <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
                </div>
              </a>
            </article>
          </li>
        {%- endfor -%}
      </ul>

      {% render 'pagination', paginate: paginate %}

    {%- else -%}
      <div class="empty-state">
        <p class="eyebrow">{{ blog.title }}</p>
        <h2 class="empty-state__title">{{ 'blogs.empty.title' | t | default: 'More wisdom coming soon.' }}</h2>
        <p class="empty-state__subtitle">{{ 'blogs.empty.subtext' | t | default: 'Check back — new posts are on the way.' }}</p>
        <div class="empty-state__actions">
          <a href="{{ routes.root_url }}" class="button button--primary">← {{ 'general.breadcrumb.home' | t }}</a>
        </div>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% stylesheet %}
  .main-blog { padding-block: var(--section-gap-y); }
  .main-blog__header { text-align: center; max-width: 720px; margin-inline: auto; margin-bottom: 3rem; }
  .main-blog__title { font-family: var(--font-heading); font-size: var(--font-size-3xl); margin-block: 0.4rem 0.75rem; }
  .main-blog__subheading { color: var(--color-muted); font-size: var(--font-size-lg); }

  .main-blog__featured { margin-bottom: 3rem; border-radius: var(--radius-lg); overflow: hidden; background: var(--color-bg-soft); transition: transform var(--transition-medium), box-shadow var(--transition-medium); }
  .main-blog__featured:hover { transform: translateY(-2px); box-shadow: var(--shadow-medium); }
  .main-blog__featured-link { display: grid; grid-template-columns: 1fr; color: inherit; text-decoration: none; }
  @media (min-width: 750px) { .main-blog__featured-link { grid-template-columns: 1.2fr 1fr; align-items: center; } }
  .main-blog__featured-media .responsive-image { border-radius: 0; }
  .main-blog__featured-body { padding: clamp(1.5rem, 3vw, 2.5rem); }
  .main-blog__featured-title { font-family: var(--font-heading); font-size: var(--font-size-3xl); line-height: 1.15; margin-block: 0.75rem 1rem; }

  .main-blog__meta { display: inline-flex; gap: 0.85rem; font-size: var(--font-size-xs); letter-spacing: var(--letter-spacing-wide); text-transform: uppercase; color: var(--color-muted); flex-wrap: wrap; }
  .main-blog__tag { color: var(--color-accent); font-weight: 600; }
  .main-blog__excerpt { color: var(--color-muted); margin-block: 0.85rem 1.25rem; line-height: 1.6; max-width: 60ch; }
  .main-blog__read-more { font-size: var(--font-size-sm); }

  .main-blog__grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 2rem; grid-template-columns: 1fr; }
  @media (min-width: 750px) {
    .main-blog__grid--columns-2 { grid-template-columns: repeat(2, 1fr); }
    .main-blog__grid--columns-3 { grid-template-columns: repeat(3, 1fr); }
  }
  .blog-card__link { display: block; color: inherit; text-decoration: none; }
  .blog-card__media { aspect-ratio: 3 / 2; border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-soft); transition: box-shadow var(--transition-medium); }
  .blog-card__link:hover .blog-card__media { box-shadow: var(--shadow-medium); }
  .blog-card__media .responsive-image, .blog-card__media .responsive-image img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-medium); }
  .blog-card__link:hover .responsive-image img { transform: scale(1.03); }
  .blog-card__body { padding-top: 1rem; }
  .blog-card__title { font-family: var(--font-heading); font-size: var(--font-size-xl); margin-block: 0.5rem 0.5rem; line-height: 1.3; }
  .blog-card__excerpt { color: var(--color-muted); font-size: var(--font-size-sm); line-height: 1.55; }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "section section--main-blog",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (defaults to blog title)" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "show_featured", "label": "Show first article as featured", "default": true },
    { "type": "range", "id": "per_page", "label": "Articles per page", "min": 6, "max": 24, "step": 3, "default": 9 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 }
  ],
  "blocks": [
    { "type": "@app" }
  ]
}
{% endschema %}
