{% comment %}
  Collection list — merchants add a block per collection to feature.
{% endcomment %}

<section class="collection-list">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-header__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="collection-list__grid collection-list__grid--columns-{{ section.settings.columns_desktop }}">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        {%- if coll != blank -%}
          <li class="collection-list__item" {{ block.shopify_attributes }}>
            <a href="{{ coll.url }}" class="collection-list__link">
              <div class="collection-list__media">
                {% render 'responsive-image',
                  image: coll.featured_image,
                  sizes: '(min-width: 750px) 33vw, 50vw',
                  aspect_ratio: 1
                %}
              </div>
              <h3 class="collection-list__title">{{ block.settings.heading | default: coll.title }}</h3>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "class": "section section--collection-list",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2, "max": 4, "step": 1, "default": 3
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "heading", "label": "Custom heading (optional)" }
      ]
    }
  ],
  "presets": [{
    "name": "Collection list",
    "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
  }]
}
{% endschema %}
