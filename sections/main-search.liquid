<div class="search-hero">
  <h1>
    {% if search.performed %}
      {% if search.results_count == 0 %}
        No results for "<em>{{ search.terms }}</em>"
      {% else %}
        Results for "<em>{{ search.terms }}</em>"
      {% endif %}
    {% else %}
      Search
    {% endif %}
  </h1>
  <form action="/search" method="get" class="search-form" role="search">
    <input
      type="search"
      name="q"
      class="search-input"
      placeholder="Search courses, tools, blog posts…"
      value="{{ search.terms | escape }}"
      autocomplete="off"
      aria-label="Search"
    >
    <button type="submit" class="search-btn">Search →</button>
  </form>
</div>

<div class="search-container">
  {% if search.performed %}
    {% if search.results_count > 0 %}
      <div class="search-results-info">
        Showing <strong>{{ search.results_count }}</strong>
        {{ search.results_count | pluralize: 'result', 'results' }} for
        "<strong>{{ search.terms | escape }}</strong>"
      </div>
      <div class="search-results-grid">
        {% for item in search.results %}
          <div class="collection-item">
            <div class="item-image-wrapper">
              {% if item.image %}
                <img src="{{ item.image | img_url: '500x500' }}" alt="{{ item.image.alt | escape }}" class="item-image">
              {% else %}
                <div style="width:100%;height:100%;background:linear-gradient(135deg,var(--terracotta-light),var(--sand));display:flex;align-items:center;justify-content:center;font-size:3rem;">📘</div>
              {% endif %}
              <div class="item-image-overlay">
                <a href="{{ item.url }}" class="overlay-btn">View →</a>
              </div>
            </div>
            <div class="item-info">
              {% if item.object_type == 'product' %}
                <div class="item-category">{{ item.type | default: 'Product' }}</div>
              {% elsif item.object_type == 'article' %}
                <div class="item-category">Article</div>
              {% else %}
                <div class="item-category">Page</div>
              {% endif %}
              <h3 class="item-title"><a href="{{ item.url }}" style="text-decoration:none;color:inherit;">{{ item.title }}</a></h3>
              {% if item.body %}
                <p class="item-description">{{ item.body | strip_html | truncatewords: 14 }}</p>
              {% endif %}
              {% if item.object_type == 'product' and item.price %}
                <div class="item-price-row">
                  <span class="item-price">{{ item.price | money }}</span>
                  {% if item.compare_at_price > item.price %}
                    <span class="item-compare">{{ item.compare_at_price | money }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="search-no-results">
        <h2>Nothing found — yet.</h2>
        <p>Try a different search term, or explore our collections and blog for everything Cat Ilacad offers.</p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
          <a href="/collections/all" class="btn-primary">Browse All Products</a>
          <a href="/blogs/news" class="btn-primary" style="background:var(--charcoal);">Read the Blog</a>
        </div>
      </div>
    {% endif %}
  {% else %}
    <div class="search-no-results">
      <h2>What are you looking for?</h2>
      <p>Search courses, tools, articles, and more from Cat Ilacad.</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Search Page",
  "tag": "section",
  "settings": []
}
{% endschema %}
