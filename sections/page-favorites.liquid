<!-- Favorites Hero -->
<div class="collection-hero">
  <div class="collection-badge">Your List</div>
  <h1>Your Favorites</h1>
  <p>The tools you've saved — ready when you are.</p>
</div>

<!-- Favorites Content -->
<div class="collection-container">
  <div id="favorites-empty" class="favorites-empty">
    <div class="favorites-empty-icon">♡</div>
    <h2>Nothing saved yet</h2>
    <p>Browse our products and hit the heart icon on anything you want to come back to.</p>
    <a href="/collections/all" class="btn-primary" style="display:inline-block;margin-top:2rem;padding:1rem 2.5rem;text-decoration:none;border-radius:50px;">Browse Products</a>
  </div>
  <div id="favorites-count" class="collection-info" style="display:none;margin-bottom:1.5rem;"></div>
  <div id="favorites-grid" class="collection-grid" style="display:none;"></div>
  {% content_for "blocks" %}
</div>

<script id="all-products-data" type="application/json">
  [
    {%- for product in collections.all.products -%}
    {
      "id":        "{{ product.id }}",
      "title":     {{ product.title | json }},
      "url":       "{{ product.url }}",
      "price":     {{ product.price }},
      "image":     "{{ product.featured_image | img_url: '500x500' }}",
      "imageAlt":  {{ product.featured_image.alt | default: product.title | json }},
      "variantId": {{ product.selected_or_first_available_variant.id }},
      "available": {{ product.available }},
      "type":      {{ product.type | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

<script>
(function () {
  var STORAGE_KEY = 'cat_wishlist';
  function getWishlist() { try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch (e) { return []; } }
  function moneyFormat(cents) {
    if (cents === 0) return 'Free';
    return '₱' + (cents / 100).toLocaleString('en-PH', { minimumFractionDigits: 2 });
  }
  function buildCard(product) {
    return (
      '<div class="collection-item">' +
        '<div class="item-image-wrapper">' +
          (product.image ? '<a href="' + product.url + '"><img src="' + product.image + '" alt="' + product.imageAlt + '" class="item-image"></a>' : '') +
          '<div class="item-image-overlay"><a href="' + product.url + '" class="overlay-btn">View Details</a></div>' +
        '</div>' +
        '<div class="item-info">' +
          (product.type ? '<div class="item-category">' + product.type + '</div>' : '') +
          '<h3 class="item-title"><a href="' + product.url + '" style="color:inherit;text-decoration:none;">' + product.title + '</a></h3>' +
          '<div class="item-price-row"><span class="item-price">' + moneyFormat(product.price) + '</span></div>' +
          '<div class="item-actions">' +
            (product.available
              ? '<form method="post" action="/cart/add" class="add-to-cart-form" style="flex:1;"><input type="hidden" name="id" value="' + product.variantId + '"><input type="hidden" name="quantity" value="1"><button type="submit" class="btn-item-cart">Add to Cart</button></form>'
              : '<button type="button" class="btn-item-cart btn-sold-out" disabled style="flex:1;">Sold Out</button>') +
            '<button class="btn-item-heart active" data-product-id="' + product.id + '" title="Remove from Wishlist" onclick="toggleWishlist(this,\'' + product.id + '\');removeFromPage(\'' + product.id + '\')">♥</button>' +
          '</div>' +
        '</div>' +
      '</div>'
    );
  }
  function removeFromPage(productId) { setTimeout(render, 50); }
  function render() {
    var allProducts = JSON.parse(document.getElementById('all-products-data').textContent);
    var wishlist = getWishlist();
    var favorites = allProducts.filter(function (p) { return wishlist.indexOf(p.id) !== -1; });
    var grid = document.getElementById('favorites-grid');
    var empty = document.getElementById('favorites-empty');
    var counter = document.getElementById('favorites-count');
    if (favorites.length === 0) {
      grid.style.display = 'none'; counter.style.display = 'none'; empty.style.display = 'block'; return;
    }
    grid.innerHTML = favorites.map(buildCard).join('');
    grid.style.display = 'grid'; counter.style.display = 'block';
    counter.innerHTML = 'Showing <strong>' + favorites.length + '</strong> saved ' + (favorites.length === 1 ? 'item' : 'items');
    empty.style.display = 'none';
  }
  document.addEventListener('DOMContentLoaded', render);
})();
</script>

<style>
  .favorites-empty { text-align: center; padding: 6rem 2rem; }
  .favorites-empty-icon { font-size: 4rem; color: var(--terracotta); margin-bottom: 1.5rem; line-height: 1; }
  .favorites-empty h2 { font-family: 'Fraunces', serif; font-size: 2rem; color: var(--charcoal); margin-bottom: 1rem; }
  .favorites-empty p { font-size: 1rem; color: var(--warm-gray); max-width: 400px; margin: 0 auto; }
</style>

{% schema %}
{
  "name": "Favorites Page",
  "tag": "section",
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Favorites Page" }],
  "settings": []
}
{% endschema %}
