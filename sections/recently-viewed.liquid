{% comment %}
  Recently-viewed wrapper section. Hides via the snippet's own logic when empty.
{% endcomment %}

{%- if section.settings.show -%}
  {% render 'recently-viewed',
    heading: section.settings.heading,
    columns_desktop: section.settings.columns_desktop,
    limit: section.settings.limit
  %}
{%- endif -%}

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "class": "section section--recently-viewed",
  "settings": [
    { "type": "checkbox", "id": "show", "label": "Show section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2, "max": 5, "step": 1, "default": 4
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products to show",
      "min": 4, "max": 12, "step": 1, "default": 8
    }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
