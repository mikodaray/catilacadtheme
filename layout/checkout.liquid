{% layout none %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ direction }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,600;9..40,700&family=Fraunces:ital,opsz,wght@0,9..144,700;1,9..144,400&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <style>
    :root {
      --co-cream:      #FDF8F9;
      --co-sand:       #F2DDE4;
      --co-terracotta: #C4748A;
      --co-deep:       #9B5070;
      --co-charcoal:   #3D1F2E;
      --co-warm-gray:  #7A6670;
      --co-gold:       #C9A84C;
    }

    /* ── Page background ── */
    body,
    .content-box,
    .main__content { background-color: var(--co-cream) !important; }

    /* ── Logo area ── */
    .logo { color: var(--co-charcoal) !important; }

    /* ── Section headers / step titles ── */
    .section__title,
    .shown-if-js .section__title { color: var(--co-charcoal) !important; }

    /* ── Labels & body text ── */
    .label,
    .field__label,
    .review-block__label,
    .address-summary,
    p { color: var(--co-warm-gray) !important; font-family: 'DM Sans', sans-serif; }

    /* ── Inputs ── */
    .field__input,
    .select__select {
      border-color: var(--co-sand) !important;
      background: white !important;
      color: var(--co-charcoal) !important;
      border-radius: 10px !important;
      font-family: 'DM Sans', sans-serif !important;
    }
    .field__input:focus,
    .select__select:focus {
      border-color: var(--co-terracotta) !important;
      box-shadow: 0 0 0 3px rgba(196,116,138,0.15) !important;
      outline: none !important;
    }

    /* ── Primary button (Pay now / Continue) ── */
    .btn--primary,
    .step__footer__continue-btn {
      background: var(--co-terracotta) !important;
      background-image: none !important;
      border: none !important;
      border-radius: 100px !important;
      font-family: 'DM Sans', sans-serif !important;
      font-weight: 700 !important;
      letter-spacing: 0.03em !important;
      transition: background 0.2s, transform 0.2s !important;
    }
    .btn--primary:hover,
    .step__footer__continue-btn:hover {
      background: var(--co-deep) !important;
      transform: translateY(-1px) !important;
    }

    /* ── Secondary / ghost buttons ── */
    .btn--secondary {
      color: var(--co-terracotta) !important;
      border-color: var(--co-sand) !important;
      border-radius: 100px !important;
      font-family: 'DM Sans', sans-serif !important;
    }

    /* ── Order summary sidebar ── */
    .order-summary { background: var(--co-charcoal) !important; }
    .order-summary__section-title,
    .order-summary__emphasis,
    .product__description__name,
    .product__description__variant,
    .order-summary__total-recap strong,
    .payment-due__currency,
    .payment-due__price { color: var(--co-cream) !important; }
    .order-summary__small-text,
    .reduction-code__text { color: rgba(255,255,255,0.4) !important; }
    .order-summary__section { border-color: rgba(255,255,255,0.07) !important; }

    /* ── Price / total ── */
    .payment-due__price { color: var(--co-gold) !important; }

    /* ── Breadcrumb / step nav ── */
    .breadcrumb__item--current .breadcrumb__text { color: var(--co-terracotta) !important; font-weight: 600 !important; }
    .breadcrumb__item .breadcrumb__text { color: var(--co-warm-gray) !important; }
    .breadcrumb__chevron path { fill: var(--co-sand) !important; }

    /* ── Checkbox & radio accents ── */
    .radio__input:checked + .radio__label::before,
    .checkbox__input:checked + .checkbox__label::before {
      background-color: var(--co-terracotta) !important;
      border-color: var(--co-terracotta) !important;
    }

    /* ── Discount / gift card tag ── */
    .tag { background: rgba(196,116,138,0.12) !important; color: var(--co-terracotta) !important; border-radius: 6px !important; }

    /* ── Footer links ── */
    .checkout-footer a { color: var(--co-warm-gray) !important; }
    .checkout-footer a:hover { color: var(--co-terracotta) !important; }

    /* ── Headings use Fraunces ── */
    h1, h2, h3,
    .section__title,
    .order-summary__emphasis { font-family: 'Fraunces', serif !important; letter-spacing: -0.02em !important; }
  </style>
</head>

<body>
  {{ content_for_layout }}
</body>
</html>
