<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_bg | default: '#FDF8F9' }}">

    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment %} hreflang alternates so search engines can index every locale. {% endcomment -%}
    {%- for lang in localization.available_languages -%}
      <link rel="alternate" hreflang="{{ lang.iso_code }}" href="{{ canonical_url | replace: shop.url, '' | prepend: shop.url | replace: '://' | append: '' }}{% if lang.primary == false %}?locale={{ lang.iso_code }}{% endif %}">
    {%- endfor -%}
    {%- if localization.available_languages.size > 0 -%}
      <link rel="alternate" hreflang="x-default" href="{{ shop.url }}">
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,700;1,9..144,300;1,9..144,400;1,9..144,700&display=swap" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="icon" type="image/png" sizes="16x16" href="{{ settings.favicon | image_url: width: 16, height: 16 }}">
    {%- endif -%}
    {%- if settings.apple_touch_icon != blank -%}
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.apple_touch_icon | image_url: width: 180, height: 180 }}">
    {%- elsif settings.favicon != blank -%}
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- comment %} LCP / hero image preload — fires per page type when an LCP image is identifiable. {% endcomment -%}
    {%- if template.name == 'product' and product.featured_image -%}
      <link rel="preload" as="image" href="{{ product.featured_image | image_url: width: 1500 }}" imagesrcset="{{ product.featured_image | image_url: width: 720 }} 720w, {{ product.featured_image | image_url: width: 1066 }} 1066w, {{ product.featured_image | image_url: width: 1500 }} 1500w" imagesizes="(min-width: 750px) 50vw, 100vw">
    {%- elsif template.name == 'collection' and collection.image -%}
      <link rel="preload" as="image" href="{{ collection.image | image_url: width: 1500 }}">
    {%- elsif template.name == 'index' and settings.homepage_preload_image -%}
      <link rel="preload" as="image" href="{{ settings.homepage_preload_image | image_url: width: 1500 }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'structured-data' -%}

    {%- comment %} Critical CSS — minimal above-the-fold styles inlined for fast first paint.
        Main stylesheet still loads normally below; we did NOT async-load it (too risky given
        the heavily layered phase-1→3 cascades). This inline block just makes sure the header
        and hero have correct typography/colour even before style.css arrives. {% endcomment -%}
    {% style %}
      :root {
        --color-bg: {{ settings.color_bg | default: '#FDF8F9' }};
        --color-text: {{ settings.color_text | default: '#3D1F2E' }};
        --color-accent: {{ settings.color_accent | default: '#C4748A' }};
        --color-bg-soft: #FAF4F6;
        --color-muted: #7A6670;
        --container-width: {{ settings.container_width | default: 1200 }}px;
        --font-heading: 'Fraunces', Georgia, serif;
        --font-body: 'DM Sans', system-ui, sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: var(--font-body);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      h1, h2, h3, h4 { font-family: var(--font-heading); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0; }
      h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.05; }
      .page-width { max-width: var(--container-width); margin-inline: auto; padding-inline: 1.5rem; }
      .visually-hidden,
      .skip-to-content-link:not(:focus):not(:focus-visible) {
        position: absolute !important; overflow: hidden;
        clip: rect(0 0 0 0); height: 1px; width: 1px;
        margin: -1px; padding: 0; border: 0; white-space: nowrap;
      }
      .skip-to-content-link:focus,
      .skip-to-content-link:focus-visible {
        position: absolute; left: 0; top: 0;
        width: auto; height: auto; clip: auto; margin: 0; padding: 0.75rem 1rem;
        background: var(--color-text); color: var(--color-bg);
        z-index: 9999; text-decoration: none;
      }
      .site-header {
        position: sticky; top: 0; z-index: 50;
        background: rgba(253, 248, 249, 0.92);
        -webkit-backdrop-filter: saturate(180%) blur(14px);
        backdrop-filter: saturate(180%) blur(14px);
        border-bottom: 1px solid rgba(61, 31, 46, 0.06);
      }
      main { display: block; }
      img { max-width: 100%; height: auto; }
    {% endstyle %}

    {%- render 'stylesheets' -%}

    {%- comment %} Bridge merchant settings into CSS variables. {% endcomment -%}
    <style>
      :root {
        --color-bg: {{ settings.color_bg | default: '#FDF8F9' }};
        --color-text: {{ settings.color_text | default: '#3D1F2E' }};
        --color-accent: {{ settings.color_accent | default: '#C4748A' }};
        --color-button: {{ settings.color_button | default: '#3D1F2E' }};
        --color-button-text: {{ settings.color_button_text | default: '#FFFFFF' }};
        --container-width: {{ settings.container_width | default: 1200 }}px;
        --button-radius: {{ settings.button_radius | default: 100 }}px;
        {%- if settings.font_heading -%}
          --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        {%- endif -%}
        {%- if settings.font_body -%}
          --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        {%- endif -%}
      }
      {%- if settings.font_heading -%}
        {{ settings.font_heading | font_face: font_display: 'swap' }}
      {%- endif -%}
      {%- if settings.font_body -%}
        {{ settings.font_body | font_face: font_display: 'swap' }}
      {%- endif -%}
    </style>

    {%- comment %} Core theme JS (custom-element registrations, utilities). Lazy modules below it. {% endcomment -%}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-to-content-link" href="#MainContent">{{ 'general.skip_to_content' | t | default: 'Skip to content' }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment %} Cart drawer — registered as a custom element in theme-cart-drawer.js. {% endcomment -%}
    {% render 'cart-drawer' %}
  </body>
</html>
